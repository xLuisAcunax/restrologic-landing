---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { productModules } from '../../lib/content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));

/**
 * Screens live in `src/assets` so Astro can fingerprint them and emit
 * responsive `srcset`s. The glob is eager because the set is tiny and the
 * lookup has to resolve during render.
 */
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/screens/*.webp',
  { eager: true },
);

function screenFor(name: string): ImageMetadata {
  const entry = screens[`../../assets/screens/${name}.webp`];
  if (!entry) {
    throw new Error(
      `[Modules] Missing screenshot "src/assets/screens/${name}.webp". ` +
        `Available: ${Object.keys(screens).join(', ')}`,
    );
  }
  return entry.default;
}
---

<section class="section" id="modules">
  <div class="container">
    <SectionHeading
      eyebrow={t('modules.eyebrow')}
      title={t('modules.title')}
      lede={t('modules.lede')}
    />

    {
      productModules.map((module, index) => (
        <article
          class={`module tone--${module.tone} ${index % 2 === 1 ? 'module--reverse' : ''}`}
        >
          <div class="module__copy" data-reveal>
            <span class="chip chip--brand">
              <Icon name={module.icon} style="width:.9rem;height:.9rem" />
              {t('modules.tag')}
            </span>

            <h3 class="module__title">{t(module.titleKey)}</h3>
            <p class="module__text">{t(module.textKey)}</p>

            <ul class="module__points">
              {module.pointKeys.map((key) => (
                <li class="module__point">
                  <Icon name="check" />
                  {t(key)}
                </li>
              ))}
            </ul>
          </div>

          <div class="module__shot" data-parallax data-reveal>
            <div class="module__frame">
              <Image
                src={screenFor(module.image)}
                alt={t(module.altKey)}
                widths={[480, 800, 1200]}
                sizes="(min-width: 60rem) 46vw, 92vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
