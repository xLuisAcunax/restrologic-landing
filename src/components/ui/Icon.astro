---
import { iconPaths, type IconName } from './icons';

/**
 * Inline SVG icon.
 *
 * Icons are inlined rather than sprited because the set is small and this
 * removes a request, a flash of un-styled glyphs, and any runtime dependency.
 * All glyphs share a 24×24 grid and are stroked with `currentColor`, so they
 * inherit colour and theme automatically.
 */

interface Props {
  name: IconName;
  size?: number | string;
  strokeWidth?: number;
  class?: string;
  /** Give the icon an accessible name; omit for purely decorative glyphs. */
  label?: string;
}

const {
  name,
  size,
  strokeWidth = 1.7,
  class: className,
  label,
} = Astro.props;

const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  style={dimension ? `width:${dimension};height:${dimension}` : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={iconPaths[name]}
/>
