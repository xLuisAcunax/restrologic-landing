---
/**
 * Prefixed-locale home page (`/en/`).
 *
 * Renders exactly the same composition as the default-locale page; every
 * component resolves its own copy from the URL, so there is nothing to keep in
 * sync between the two routes.
 */
import Layout from '../../layouts/Layout.astro';
import RedesignLanding from '../../components/RedesignLanding.astro';
import { languages, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}
---

<Layout>
  <RedesignLanding />
</Layout>
